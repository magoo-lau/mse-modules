<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-modules</groupId>
        <artifactId>mse-ai</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-api</artifactId>
    <name>ai-api</name>
    <description>AI 平台契约（接口 + Serializable DTO，供其他服务经 @RpcReference 消费 AI 能力、经 RemoteAiTool 向智能体注册业务工具并自注册到工具中心）</description>

    <dependencies>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- 模块 biz 查询工具基类：租户 raw 连接路由器（运行期宿主经 starter-mybatis 提供），
             jsqlparser 经 common-mybatis → mybatis-plus-jsqlparser 传递（SQL 防护器编译期需要） -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-mybatis</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 模块 biz 查询工具基类入参解析（Jackson 3，版本走 Spring Boot BOM；运行期宿主必带） -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 工具自注册推送装配：Spring 事件/环境（运行期宿主必带，provided 不污染业务依赖树） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- dubbo 模式推送：编程式 ReferenceConfig（运行期微服务宿主经 micro-starter 提供）；
             common-rpc 提供 DubboRuntimeConfigs（宿主经 starter-rpc 传递） -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-rpc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- SQL 防护器回归测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
