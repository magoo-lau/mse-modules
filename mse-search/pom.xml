<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立工程：parent 指向基座 mse-starter-parent（编译/插件/BOM/仓库统一收编，随框架 mvn install），
         仅通过 BOM 消费基座发布件（积木式组装），不属于 ai-mse 聚合模块 -->
    <parent>
        <groupId>com.github.magoo-lau.mse-framework</groupId>
        <artifactId>mse-starter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.github.magoo-lau.mse-modules</groupId>
    <artifactId>mse-search</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-search</name>
    <description>搜索引擎服务：可搜索源注册 + 定时增量扫描分片 + MQ 实时事件 + Elasticsearch 索引 + 三层权限过滤（租户/权限码/个人数据范围） + 闲时任务</description>

    <modules>
        <module>search-api</module>
        <module>search-service</module>
        <module>search-boot</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 本工程模块 -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-modules</groupId>
                <artifactId>search-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-modules</groupId>
                <artifactId>search-service</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
    <repository>
        <id>jitpack</id>
        <url>https://jitpack.io</url>
    </repository>
    </repositories>
</project>
