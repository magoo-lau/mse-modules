<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-modules</groupId>
        <artifactId>mse-search</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>search-boot</artifactId>
    <name>search-boot</name>
    <description>搜索引擎微服务启动器：micro-starter + search-service + mq-starter；mse.rpc.mode 默认 dubbo，启动即注册供网关 lb://mse-search 路由</description>

    <dependencies>
        <!-- 微服务形态入口启动器：Nacos 配置/注册 + Dubbo RPC（mse.rpc.mode 默认 dubbo）+ 基座契约消费桥接
             （鉴权数据源 @SaCheckPermission / 独立库租户路由 / 操作日志 RPC 回退，本服务不打包基座 HTTP 接口）
             + Seata 内置 + actuator + 三方言 JDBC 驱动 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>micro-starter</artifactId>
        </dependency>
        <!-- 自有业务积木 -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-modules</groupId>
            <artifactId>search-service</artifactId>
        </dependency>
        <!-- 按需选装：RocketMQ 索引事件（实时增量通道；未配置 name-server 时监听器不注册，扫描兜底） -->
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>mq-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
