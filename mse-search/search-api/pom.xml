<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.magoo-lau.mse-modules</groupId>
        <artifactId>mse-search</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>search-api</artifactId>
    <name>search-api</name>
    <description>搜索引擎契约积木：可搜索源自注册（Contributor/Descriptor/Pusher）+ 增量数据提供者契约 + 索引事件结构。业务工程只依赖本 jar 即完成接入，mse-search 不依赖任何业务 jar</description>

    <dependencies>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-core</artifactId>
        </dependency>
        <!-- 注册推送装配：Spring 事件/环境（运行期宿主必带，provided 不污染业务依赖树） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- dubbo 模式推送：编程式 ReferenceConfig（运行期微服务宿主经 micro-starter 提供）；
             common-rpc 提供 DubboRuntimeConfigs（宿主经 starter-rpc 传递） -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.magoo-lau.mse-framework</groupId>
            <artifactId>common-rpc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
