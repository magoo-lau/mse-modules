# ==================== mse-im · OpenIM 实例环境变量（docker compose 自动读取） ====================
# 生产/租户部署必须替换全部 openIM123 / change-me 默认值；mse 侧 mse.im.server.secret 与
# OPENIM_SECRET 必须一致（OpenImClient 以它调 /auth/get_admin_token）。

# ---- 镜像（OpenIM 锁定 v3.8.3-patch.x，升级走独立租户实例灰度） ----
# 注：Docker Hub 无 patch.16 镜像 tag（发布滞后），官方 openim-docker 锚定 patch.15，从之；
# redis/minio 取本机已有 tag（拉取受限时的等价替换，语义兼容）
MONGO_IMAGE=mongo:7.0.28
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=bitnamilegacy/kafka:3.5.1
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z
ETCD_IMAGE=bitnamilegacy/etcd:3.5.13
OPENIM_SERVER_IMAGE=openim/openim-server:v3.8.3-patch.15

# ---- 数据目录（相对本目录） ----
DATA_DIR=./data

# ---- MongoDB ----
MONGO_ADDRESS=im-mongo:27017
MONGO_USERNAME=openIM
MONGO_PASSWORD=openIM123

# ---- Kafka / etcd / Redis（容器网络内主机名） ----
KAFKA_ADDRESS=im-kafka:9094
ETCD_ADDRESS=im-etcd:2379
REDIS_ADDRESS=im-redis:6379
REDIS_PASSWORD=openIM123

# ---- MinIO（消息图片/文件对象存储） ----
MINIO_INTERNAL_ADDRESS=im-minio:9000
MINIO_EXTERNAL_ADDRESS=http://127.0.0.1:10005
MINIO_ACCESS_KEY_ID=root
MINIO_SECRET_ACCESS_KEY=openIM123
MINIO_PORT=10005
MINIO_CONSOLE_PORT=10004

# ---- LiveKit（音视频通话 RTC；1v1 媒体房间） ----
# key/secret 必须与 mse 侧 mse.im.livekit.api-key/api-secret 一致（token 由 mse-im 签发）
# 生产改强随机 secret；LIVEKIT_NODE_IP 为客户端可达的宿主机地址（本机开发 127.0.0.1，生产填公网 IP）
LIVEKIT_IMAGE=livekit/livekit-server:latest
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_API_KEY=mse-devkey
LIVEKIT_API_SECRET=mse-im-poc-rtc-secret-change-me
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_UDP_START=7880
LIVEKIT_UDP_END=7889

# ---- OpenIM ----
# 实例 secret：生产必须为强随机值，且与 mse 侧 mse.im.server.secret 完全一致
OPENIM_SECRET=mse-im-poc-secret-change-me
OPENIM_API_PORT=10002
OPENIM_MSG_GATEWAY_PORT=10001
# IM token 有效期：经实测 IMENV_TOKENPOLICY_EXPIRE 环境变量不生效（2026-09-27），
# 以挂载覆盖 config/openim-rpc-auth.yml 的 tokenPolicy.expire=7 实现（见 docker-compose.yaml volumes）

# ---- 日志 ----
LOG_IS_STDOUT=true
LOG_LEVEL=3
