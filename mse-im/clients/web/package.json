{
  "name": "im-web-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/clients/web/",
    "build:desktop": "vite build --base=/ --outDir dist-desktop --emptyOutDir",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs=require('fs');const s='node_modules/@openim/wasm-client-sdk/assets/';fs.mkdirSync('public/sdk',{recursive:true});for(const f of ['openIM.wasm','sql-wasm.wasm','wasm_exec.js','version']){if(fs.existsSync(s+f))fs.copyFileSync(s+f,'public/sdk/'+f);}\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@openim/wasm-client-sdk": "^3.8.3-patch.15.1",
    "axios": "^1.7.9",
    "livekit-client": "^2.13.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
