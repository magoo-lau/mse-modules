<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mseapp</groupId>
        <artifactId>mse-monitor</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>monitor-service</artifactId>
    <name>monitor-service</name>
    <description>监控中心业务积木（纯 jar，无 main）：目标管理 + 采集引擎（服务/HTTP/MySQL/Redis/RocketMQ/OS 探测）+ 告警通知</description>

    <dependencies>
        <!-- 基座技术积木（starter-* 内部装配件：自动装配随 jar 走，工具本体经其传递带入） -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>starter-security</artifactId>
        </dependency>
        <!-- 基座契约：用户检索（通知收件人选择）+ 站内消息投递（告警通知独立直发），
             @RpcReference 注解在 common-core（经 api-system 传递），运行期由 starter-rpc 处理 -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>api-system</artifactId>
        </dependency>
        <!-- Redis 探测（Lettuce 直连目标实例，版本由 Spring Boot BOM 仲裁） -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>
        <!-- 本机操作系统采集（版本由本工程父 pom 仲裁） -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>
        <!-- RocketMQ 集群探测（DefaultMQAdminExt，版本与服务端 5.3.1 对齐） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-tools</artifactId>
        </dependency>
    </dependencies>
</project>
