<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立工程：parent 指向基座 mse-starter-parent（编译/插件/BOM/仓库统一收编，随框架 mvn install），
         仅通过 BOM 消费基座发布件（积木式组装），不属于 ai-mse 聚合模块 -->
    <parent>
        <groupId>vip.mseapp</groupId>
        <artifactId>mse-starter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>vip.mseapp</groupId>
    <artifactId>mse-data</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-data</name>
    <description>多租户数据中台：数据源管理 + 元数据/数据地图 + 数据集成同步 + 数据服务 API（data-service）+ 启动器（data-boot）</description>

    <modules>
        <module>data-api</module>
        <module>data-service</module>
        <module>data-boot</module>
    </modules>

    <properties>
        <!-- 基座 BOM 未仲裁的补充版本：PostgreSQL 驱动（二期数据源类型） -->
        <postgresql.version>42.7.5</postgresql.version>
        <!-- mse-open 开放平台契约（biz↔biz 依赖，无 BOM 仲裁，显式版本） -->
        <open-api.version>1.0.0-SNAPSHOT</open-api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <!-- 本工程模块 -->
            <dependency>
                <groupId>vip.mseapp</groupId>
                <artifactId>data-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>vip.mseapp</groupId>
                <artifactId>data-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- mse-open 开放平台契约：开放能力自注册（OpenApiContributor/Descriptor） -->
            <dependency>
                <groupId>vip.mseapp</groupId>
                <artifactId>open-api</artifactId>
                <version>${open-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
