<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mseapp</groupId>
        <artifactId>mse-fs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fs-service</artifactId>
    <name>fs-service</name>
    <description>文件存储业务积木（纯 jar，无 main）：统一存储抽象 + RustFS 1.x（S3 兼容）/本地文件系统可配置回退 + 租户隔离 + 文件元数据管理</description>

    <dependencies>
        <!-- 基座技术积木（starter-* 内部装配件：自动装配随 jar 走，工具本体经其传递带入） -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>starter-security</artifactId>
        </dependency>
        <!-- 文件存储契约（框架区 mse-api，实现方为本模块；BOM 仲裁版本） -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>api-fs</artifactId>
        </dependency>
        <!-- 开放平台契约：OpenApiContributor 自注册（开放上传/查询/下载/删除到 mse-open 目录） -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>open-api</artifactId>
        </dependency>
        <!-- 租户契约：存储迁移逐租户世界扫描（RemoteTenantService.listTenants，单体本地实现/微服务 dubbo） -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>api-tenant</artifactId>
        </dependency>
        <!-- S3 兼容客户端（RustFS 1.x / MinIO 等）：optional 不传递——嵌入方（如单体）不引即纯本地
             存储模式；微服务启动器 fs-boot 显式引入，两种模式可经 Nacos 配置随时切换 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
