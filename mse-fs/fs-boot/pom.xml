<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>vip.mseapp</groupId>
        <artifactId>mse-fs</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fs-boot</artifactId>
    <name>fs-boot</name>
    <description>文件存储服务微服务启动器：micro-starter + fs-service + RustFS 客户端 SDK；mse.rpc.mode 默认 dubbo，
        鉴权经契约消费 mse-system，启动即注册供网关 lb://mse-fs 路由</description>

    <dependencies>
        <!-- 微服务形态入口启动器：Nacos 配置/注册 + Dubbo RPC（mse.rpc.mode 默认 dubbo）+ 基座契约消费桥接
             （鉴权数据源 @SaCheckPermission / 独立库租户路由 / 操作日志 RPC 回退，本服务不打包基座 HTTP 接口）
             + Seata 内置 + actuator + 三方言 JDBC 驱动 -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>micro-starter</artifactId>
        </dependency>
        <!-- 自有业务积木 -->
        <dependency>
            <groupId>vip.mseapp</groupId>
            <artifactId>fs-service</artifactId>
        </dependency>
        <!-- S3 兼容客户端（RustFS 1.x）：fs-service 中为 optional 不传递，启动器显式引入后
             local/rustfs 两种存储模式可经 Nacos 配置（mse.fs.storage.type）随时切换，无需重打包 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
